# ---------------------------------------------------------------- required ---
# Public origin of the app itself. This is the OAuth issuer and the base for the
# MCP endpoint (<A2W_PUBLIC_URL>/mcp), so it must match what clients dial.
# Claude requires https in production.
A2W_PUBLIC_URL=https://a2w.example.com

# Signing key for cookies and for hashing tokens at rest. 32+ characters.
A2W_SECRET=replace-me-with-npm-run-gen-secrets

# Owner credential. Generate the hash with `npm run gen-secrets`.
# A2W_ADMIN_PASSWORD may be used instead for a quick start, but is discouraged.
A2W_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace$me
# A2W_ADMIN_PASSWORD=

# ---------------------------------------------------------------- optional ---
# Second factor for the admin password: base32 secret from your authenticator.
# A2W_ADMIN_TOTP_SECRET=

# Static bearer token for Claude Code, curl and CI. 32+ characters.
# Leave unset to allow OAuth only.
# A2W_API_TOKEN=

# Serve every site at https://<slug>.<domain>/ as well. Needs wildcard DNS and a
# wildcard TLS certificate. Use a different domain than A2W_PUBLIC_URL.
# A2W_SITES_BASE_DOMAIN=sites.example.com

# Path prefix for path-based hosting (always available).
# A2W_SITES_PATH_PREFIX=/s

# Sandbox published pages with a CSP that gives them an opaque origin.
# auto (default) sandboxes only pages served from the app's own origin,
# i.e. the /s/<slug>/ URLs. Set to `never` if your pages need localStorage or
# same-origin fetch and you accept sharing the origin with the admin UI.
# A2W_SITE_SANDBOX=auto

# Storage, networking and limits.
# A2W_DATA_DIR=/data
# A2W_PORT=8080
# A2W_BIND=0.0.0.0
# A2W_TRUST_PROXY=true
# A2W_MAX_FILE_BYTES=5242880
# A2W_MAX_SITE_BYTES=52428800
# A2W_MAX_FILES=200
# A2W_KEEP_VERSIONS=10
# A2W_SITE_COOKIE_TTL_HOURS=168
# A2W_ADMIN_SESSION_TTL_HOURS=12

# Extra exact OAuth redirect URIs, comma separated. Claude's own callbacks and
# http loopback URLs are allowed without listing them here.
# A2W_EXTRA_REDIRECT_URIS=
