{
  "name": "agent2web",
  "version": "0.1.0",
  "description": "Self-hosted static site hosting with an MCP publishing API, for HTML built by AI tools like Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && wrangler dev",
    "test": "npm run build && node --test build/test/*.test.js",
    "gen-secrets": "npm run build --silent && node scripts/secrets.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mime": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "miniflare": "^4.20260722.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.114.0"
  }
}
