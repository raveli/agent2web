{
  "name": "agent2web",
  "version": "0.1.0",
  "description": "Self-hosted static site hosting with an MCP publishing API, for HTML built by AI tools like Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node build/src/index.js",
    "dev": "npm run build && node --enable-source-maps --watch build/src/index.js",
    "test": "npm run build && node --test build/test/*.test.js",
    "gen-secrets": "npm run build --silent && node build/src/cli/secrets.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "express": "^5.2.1",
    "mime": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
